// Cloudflare Workers con static assets. Producción: `npm run build:live && npx wrangler deploy`;
// ramas: `npm run build && npx wrangler preview` (Worker Previews, Wrangler >= 4.135).
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "indaxion-landing",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    // Toda ruta sin archivo sirve index.html (SPA)
    "not_found_handling": "single-page-application"
  },
  // Dominio propio (Custom Domain: Cloudflare crea el DNS y el certificado al desplegar).
  // www.indaxion.com redirige a la raíz con una Redirect Rule de la zona.
  "routes": [
    { "pattern": "indaxion.com", "custom_domain": true }
  ],
  // Se conserva indaxion-landing.indaxion.workers.dev y las URLs de Preview usan workers.dev
  "workers_dev": true,
  // Obligatorio para Worker Previews; vacío porque el sitio no usa variables ni bindings
  "previews": {}
}
